ity.zip/content"}}], "swh": null, "owners": [{"id": "1365512"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 16, "unique_views": 16, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 16, "version_views": 16}, "state": "done", "submitted": true}, {"created": "2026-06-17T06:59:59.473299+00:00", "modified": "2026-06-17T06:59:59.751256+00:00", "id": 20725338, "conceptrecid": "20725337", "doi": "10.5281/zenodo.20725338", "conceptdoi": "10.5281/zenodo.20725337", "doi_url": "https://doi.org/10.5281/zenodo.20725338", "metadata": {"title": "Experimental and Computational Raw Data for Site-Selective Oxygen Intercalation in h-BN/Ru(0001) Moire Superlattices for On-Surface Electrostatic Catalysis", "doi": "10.5281/zenodo.20725338", "publication_date": "2026-06-17", "description": "<p>This dataset contains the experimental and computational raw data supporting the manuscript \"Site-Selective Oxygen Intercalation in h-BN/Ru(0001) Moire Superlattices for On-Surface Electrostatic Catalysis\" (Manuscript ID: ja-2026-11613k). The archive is organized into two main folders: Experimental Raw Data and Computational Raw Data.</p>\n<p>Experimental Raw Data contains raw STM topography files (.sxm), FER spectroscopy data (.dat), and XPS spectrum files (.pxt), organized by main-text and Supporting Information figure number. Computational Raw Data contains machine-readable structure files, Hartree-potential line-profile data, metadata and summary files for Figure 4a-c, and CP2K NEB path-point coordinates and total/relative energy data for Figure 4d.</p>\n<p>Each raw-data section includes a README file that explains the file formats, figure mapping, data organization, and how reviewers can inspect or reuse the files.</p>", "access_right": "open", "creators": [{"name": "Ju, Lin-feng", "affiliation": null}, {"name": "Cao, Zhi-long", "affiliation": null}, {"name": "Xi, Yi-xin", "affiliation": null}, {"name": "Xu, Ji-lian", "affilia