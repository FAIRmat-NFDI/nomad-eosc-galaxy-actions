{
  "schema_version": 3,
  "zenodo_url": "https://zenodo.org",
  "zenodo_query": "(\"scanning tunneling microscopy\" OR STM) AND (Nanonis OR \".sxm\") AND resource_type.type:dataset",
  "zenodo_request_delay": 2.0,
  "raw_extensions": [".sxm"],
  "context_extensions": [".txt", ".md", ".pdf", ".rtf", ".csv", ".json", ".yaml", ".yml", ".docx"],
  "ignore_patterns": ["__MACOSX/*", "*.DS_Store", "*.mp4"],
  "licenses": ["cc-zero", "cc-by-4.0"],
  "max_archive_bytes": 2000000000,
  "max_uncompressed_bytes": 10000000000,
  "galaxy_url": "https://usegalaxy.eu",
  "galaxy_workflow_id": "",
  "nomad_url": "",
  "state_dir": ""
}
